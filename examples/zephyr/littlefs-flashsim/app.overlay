/* RAM-backed flash (flash simulator) with a 32 KiB partition, and an fstab entry: LittleFS is
 * mounted at /lfs during boot (automount) and formatted on first use. On a real board point
 * `partition` at a partition of its flash (internal, or an external SPI NOR) and drop the simulator.
 */
/ {
	sim_flash_controller: sim_flash_controller {
		compatible = "zephyr,sim-flash";
		#address-cells = <1>;
		#size-cells = <1>;
		erase-value = <0xff>;

		flash_sim0: flash_sim@0 {
			compatible = "soc-nv-flash";
			reg = <0x00000000 0x8000>;
			erase-block-size = <1024>;
			write-block-size = <4>;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				lfs_partition: partition@0 {
					label = "lfs";
					reg = <0x00000000 0x8000>;
				};
			};
		};
	};

	fstab {
		compatible = "zephyr,fstab";
		lfs1: lfs1 {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&lfs_partition>;
			automount;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};
